# Copy this file to `.env` (at the project root) and fill in real values.
# Never commit the real `.env` file — it is in `.gitignore`.

# ---- Django ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=False
# Comma-separated hostnames. "*" is fine for local docker / quick tests.
DJANGO_ALLOWED_HOSTS=*
# Comma-separated origins (e.g. https://paperiq.example.com). Only needed
# when serving the site behind a custom domain over HTTPS.
DJANGO_CSRF_TRUSTED_ORIGINS=

# ---- MongoDB Atlas ----
# Make sure the cluster's Network Access allows the IP of the host running
# Docker (or temporarily allow 0.0.0.0/0 while testing).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/paperiq_db?retryWrites=true&w=majority
MONGODB_DB_NAME=paperiq_db

# ---- Google Gemini ----
GEMINI_API_KEY=replace-with-your-google-ai-key
# Optional model override. The default is gemini-3.1-pro-preview.
GEMINI_MODEL=gemini-3.1-pro-preview

# ---- Gunicorn ----
WEB_CONCURRENCY=2
